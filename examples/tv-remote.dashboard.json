{
  "version": "1.0",
  "dashboards": [
    {
      "id": "dashboard_tv_remote",
      "name": "TV remote",
      "description": "Remote for atv-bridge TVs. Pick the TV in the variable bar; each option is <bridge>.<device>, the TV's key in atv_state. Needs publish on atv.<bridge>.<device>.> for each TV and read on the atv_state KV bucket.",
      "created": 1794097902871,
      "modified": 1794097902871,
      "widgets": [
        {
          "id": "widget_remote_1",
          "title": "Connection",
          "x": 0,
          "y": 0,
          "w": 3,
          "h": 2,
          "dataSource": {
            "type": "kv",
            "kvBucket": "atv_state",
            "kvKey": "{{tv}}"
          },
          "buffer": {
            "maxCount": 10
          },
          "type": "status",
          "jsonPath": "$.available",
          "statusConfig": {
            "mappings": [
              {
                "id": "1",
                "blink": false,
                "value": "true",
                "color": "var(--color-success)",
                "label": "Connected"
              },
              {
                "id": "2",
                "blink": false,
                "value": "false",
                "color": "var(--color-error)",
                "label": "Offline"
              }
            ],
            "defaultColor": "var(--muted)",
            "defaultLabel": "Unknown",
            "showStale": false
          }
        },
        {
          "id": "widget_remote_2",
          "title": "Power",
          "x": 3,
          "y": 0,
          "w": 3,
          "h": 2,
          "dataSource": {
            "type": "kv",
            "kvBucket": "atv_state",
            "kvKey": "{{tv}}"
          },
          "buffer": {
            "maxCount": 10
          },
          "type": "status",
          "jsonPath": "$.on",
          "statusConfig": {
            "mappings": [
              {
                "id": "1",
                "blink": false,
                "value": "true",
                "color": "var(--color-success)",
                "label": "On"
              },
              {
                "id": "2",
                "blink": false,
                "value": "false",
                "color": "var(--muted)",
                "label": "Off"
              }
            ],
            "defaultColor": "var(--muted)",
            "defaultLabel": "Unknown",
            "showStale": false
          }
        },
        {
          "id": "widget_remote_3",
          "title": "Power buttons",
          "x": 6,
          "y": 0,
          "w": 6,
          "h": 2,
          "dataSource": {
            "type": "subscription"
          },
          "buffer": {
            "maxCount": 10
          },
          "type": "buttonpad",
          "buttonpadConfig": {
            "rows": 1,
            "cols": 2,
            "cells": [
              {
                "row": 0,
                "col": 0,
                "label": "On",
                "subject": "atv.{{tv}}.power",
                "payload": "{\"on\":true}",
                "color": "#16a34a"
              },
              {
                "row": 0,
                "col": 1,
                "label": "Off",
                "subject": "atv.{{tv}}.power",
                "payload": "{\"on\":false}",
                "color": "#dc2626"
              }
            ]
          }
        },
        {
          "id": "widget_remote_4",
          "title": "Now playing",
          "x": 0,
          "y": 2,
          "w": 6,
          "h": 6,
          "dataSource": {
            "type": "kv",
            "kvBucket": "atv_state",
            "kvKey": "{{tv}}"
          },
          "buffer": {
            "maxCount": 10
          },
          "type": "markdown",
          "markdownConfig": {
            "content": "**App:** `{{app}}`\n\n**Volume:** {{volume.level}} of {{volume.max}} (muted: {{volume.muted}})\n\n**Paired:** {{paired}} · **Device:** {{device.manufacturer}} {{device.model}}\n\n**Last change:** {{since}}"
          }
        },
        {
          "id": "widget_remote_5",
          "title": "Navigation",
          "x": 6,
          "y": 2,
          "w": 6,
          "h": 6,
          "dataSource": {
            "type": "subscription"
          },
          "buffer": {
            "maxCount": 10
          },
          "type": "buttonpad",
          "buttonpadConfig": {
            "rows": 3,
            "cols": 3,
            "cells": [
              {
                "row": 0,
                "col": 0,
                "label": "Back",
                "subject": "atv.{{tv}}.key",
                "payload": "{\"key\":\"BACK\"}",
                "color": "#475569"
              },
              {
                "row": 0,
                "col": 1,
                "label": "↑",
                "subject": "atv.{{tv}}.key",
                "payload": "{\"key\":\"DPAD_UP\"}",
                "color": "#2563eb"
              },
              {
                "row": 0,
                "col": 2,
                "label": "Home",
                "subject": "atv.{{tv}}.key",
                "payload": "{\"key\":\"HOME\"}",
                "color": "#475569"
              },
              {
                "row": 1,
                "col": 0,
                "label": "←",
                "subject": "atv.{{tv}}.key",
                "payload": "{\"key\":\"DPAD_LEFT\"}",
                "color": "#2563eb"
              },
              {
                "row": 1,
                "col": 1,
                "label": "OK",
                "subject": "atv.{{tv}}.key",
                "payload": "{\"key\":\"DPAD_CENTER\"}",
                "color": "#7c3aed"
              },
              {
                "row": 1,
                "col": 2,
                "label": "→",
                "subject": "atv.{{tv}}.key",
                "payload": "{\"key\":\"DPAD_RIGHT\"}",
                "color": "#2563eb"
              },
              {
                "row": 2,
                "col": 0,
                "label": "Menu",
                "subject": "atv.{{tv}}.key",
                "payload": "{\"key\":\"MENU\"}",
                "color": "#475569"
              },
              {
                "row": 2,
                "col": 1,
                "label": "↓",
                "subject": "atv.{{tv}}.key",
                "payload": "{\"key\":\"DPAD_DOWN\"}",
                "color": "#2563eb"
              },
              {
                "row": 2,
                "col": 2,
                "label": "Settings",
                "subject": "atv.{{tv}}.key",
                "payload": "{\"key\":\"SETTINGS\"}",
                "color": "#475569"
              }
            ]
          }
        },
        {
          "id": "widget_remote_6",
          "title": "Playback",
          "x": 0,
          "y": 8,
          "w": 6,
          "h": 2,
          "dataSource": {
            "type": "subscription"
          },
          "buffer": {
            "maxCount": 10
          },
          "type": "buttonpad",
          "buttonpadConfig": {
            "rows": 1,
            "cols": 3,
            "cells": [
              {
                "row": 0,
                "col": 0,
                "label": "Rewind",
                "subject": "atv.{{tv}}.key",
                "payload": "{\"key\":\"MEDIA_REWIND\"}",
                "color": "#0f766e"
              },
              {
                "row": 0,
                "col": 1,
                "label": "Play/Pause",
                "subject": "atv.{{tv}}.key",
                "payload": "{\"key\":\"MEDIA_PLAY_PAUSE\"}",
                "color": "#0f766e"
              },
              {
                "row": 0,
                "col": 2,
                "label": "Forward",
                "subject": "atv.{{tv}}.key",
                "payload": "{\"key\":\"MEDIA_FAST_FORWARD\"}",
                "color": "#0f766e"
              }
            ]
          }
        },
        {
          "id": "widget_remote_7",
          "title": "Volume",
          "x": 6,
          "y": 8,
          "w": 6,
          "h": 2,
          "dataSource": {
            "type": "subscription"
          },
          "buffer": {
            "maxCount": 10
          },
          "type": "buttonpad",
          "buttonpadConfig": {
            "rows": 1,
            "cols": 3,
            "cells": [
              {
                "row": 0,
                "col": 0,
                "label": "Vol −",
                "subject": "atv.{{tv}}.key",
                "payload": "{\"key\":\"VOLUME_DOWN\"}",
                "color": "#475569"
              },
              {
                "row": 0,
                "col": 1,
                "label": "Mute",
                "subject": "atv.{{tv}}.key",
                "payload": "{\"key\":\"VOLUME_MUTE\"}",
                "color": "#475569"
              },
              {
                "row": 0,
                "col": 2,
                "label": "Vol +",
                "subject": "atv.{{tv}}.key",
                "payload": "{\"key\":\"VOLUME_UP\"}",
                "color": "#475569"
              }
            ]
          }
        },
        {
          "id": "widget_remote_8",
          "title": "Apps",
          "x": 0,
          "y": 10,
          "w": 12,
          "h": 2,
          "dataSource": {
            "type": "subscription"
          },
          "buffer": {
            "maxCount": 10
          },
          "type": "buttonpad",
          "buttonpadConfig": {
            "rows": 1,
            "cols": 4,
            "cells": [
              {
                "row": 0,
                "col": 0,
                "label": "YouTube",
                "subject": "atv.{{tv}}.launch",
