            ]
          }
        },
        {
          "id": "widget_remote_9",
          "title": "Type text",
          "x": 0,
          "y": 12,
          "w": 12,
          "h": 4,
          "dataSource": {
            "type": "subscription"
          },
          "buffer": {
            "maxCount": 10
          },
          "type": "publisher",
          "publisherConfig": {
            "defaultSubject": "atv.{{tv}}.text",
            "defaultPayload": "{\"text\": \"type here\"}",
            "history": [],
            "timeout": 2000
          }
        }
      ],
      "variables": [
        {
          "id": "var_tv",
          "name": "tv",
          "label": "TV",
          "type": "select",
          "options": [
            "ATV-V7Q-NB9.bedroom"
          ],
          "defaultValue": "ATV-V7Q-NB9.bedroom"
        }
      ],
      "isLocked": true,
      "storage": "local",
      "columnCount": 12
    }
  ]
}
