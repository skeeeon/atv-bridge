{
  "version": "1.0",
  "dashboards": [
    {
      "id": "dashboard_bedroom_remote",
      "name": "Bedroom TV remote",
      "description": "Remote for bedroom on atv-bridge ATV-V7Q-NB9. Needs publish on atv.ATV-V7Q-NB9.bedroom.> and read on the atv_state KV bucket.",
      "created": 1794091349940,
      "modified": 1794091349940,
      "widgets": [
        {
          "id": "widget_remote_1",
          "title": "Connection",
          "x": 0,
          "y": 0,
          "w": 3,
          "h": 2,
          "dataSource": {
            "type": "kv",
            "kvBucket": "atv_state",
            "kvKey": "ATV-V7Q-NB9.bedroom"
          },
          "buffer": {
            "maxCount": 10
          },
          "type": "status",
          "jsonPath": "$.available",
          "statusConfig": {
            "mappings": [
              {
                "id": "1",
                "blink": false,
                "value": "true",
                "color": "var(--color-success)",
                "label": "Connected"
              },
              {
                "id": "2",
                "blink": false,
                "value": "false",
                "color": "var(--color-error)",
                "label": "Offline"
              }
            ],
            "defaultColor": "var(--muted)",
            "defaultLabel": "Unknown",
            "showStale": false
          }
        },
        {
          "id": "widget_remote_2",
          "title": "Power",
          "x": 3,
          "y": 0,
          "w": 3,
          "h": 2,
          "dataSource": {
            "type": "kv",
            "kvBucket": "atv_state",
            "kvKey": "ATV-V7Q-NB9.bedroom"
          },
          "buffer": {
            "maxCount": 10
          },
          "type": "status",
          "jsonPath": "$.on",
          "statusConfig": {
            "mappings": [
              {
                "id": "1",
                "blink": false,
                "value": "true",
                "color": "var(--color-success)",
                "label": "On"
              },
              {
                "id": "2",
                "blink": false,
                "value": "false",
                "color": "var(--muted)",
                "label": "Off"
              }
            ],
            "defaultColor": "var(--muted)",
            "defaultLabel": "Unknown",
            "showStale": false
          }
        },
        {
          "id": "widget_remote_3",
          "title": "Power on",
          "x": 6,
          "y": 0,
          "w": 3,
          "h": 2,
          "dataSource": {
            "type": "subscription"
          },
          "buffer": {
            "maxCount": 10
          },
          "type": "button",
          "buttonConfig": {
            "label": "On",
            "publishSubject": "atv.ATV-V7Q-NB9.bedroom.power",
            "payload": "{\"on\":true}",
            "actionType": "publish",
            "timeout": 2000,
            "color": "#16a34a"
          }
        },
        {
          "id": "widget_remote_4",
          "title": "Power off",
          "x": 9,
          "y": 0,
