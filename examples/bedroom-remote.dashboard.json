          "h": 2,
          "dataSource": {
            "type": "subscription"
          },
          "buffer": {
            "maxCount": 10
          },
          "type": "button",
          "buttonConfig": {
            "label": "Off",
            "publishSubject": "atv.ATV-V7Q-NB9.bedroom.power",
            "payload": "{\"on\":false}",
            "actionType": "publish",
            "timeout": 2000,
            "color": "#dc2626"
          }
        },
